    {
      "parameters": {
        "operation": "executeQuery",
        "query": "BEGIN;\n\nUPDATE task_queue\nSET\n  status       = 'cancelled',\n  locked_by    = NULL,\n  locked_at    = NULL,\n  locked_until = NULL,\n  finished_at  = now(),\n  updated_at   = now(),\n  last_error   = COALESCE(last_error, 'cancelled_by_operator')\nWHERE task_type_code = 'parser_add_channel'\n  AND status IN ('queued', 'scheduled', 'retry', 'stuck', 'in_progress');\n\n-- снять резерв аккаунтов, если задача add ещё держала current_task_id\nUPDATE accounts a\nSET current_task_id = NULL, updated_at = now()\nWHERE current_task_id IN (\n  SELECT id FROM task_queue\n  WHERE task_type_code = 'parser_add_channel'\n    AND status = 'cancelled'\n    AND finished_at >= now() - interval '1 minute'\n);\n\nCOMMIT;",
        "options": {}
      },
