    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH\n-- Условие «канал реально включён в активном проекте»\nactive_project_links AS (\n  SELECT\n    psc.source_channel_id AS channel_id,\n    psc.monitoring_project_id AS project_id,\n    mp.name AS project_name\n  FROM project_source_channels psc\n  INNER JOIN monitoring_projects mp\n    ON mp.id = psc.monitoring_project_id\n  WHERE psc.is_enabled = true\n    AND mp.status = 'active'::project_status\n    AND mp.deleted_at IS NULL\n),\nenabled_in_projects AS (\n  SELECT\n    sc.id,\n    sc.name,\n    sc.external_url,\n    COUNT(DISTINCT apl.project_id) AS active_projects_count,\n    STRING_AGG(DISTINCT apl.project_name, ', ' ORDER BY apl.project_name) AS project_names\n  FROM source_channels sc\n  INNER JOIN active_project_links apl\n    ON apl.channel_id = sc.id\n  WHERE sc.platform_id = 2   -- Telegram; уберите WHERE для всех платформ\n  GROUP BY sc.id, sc.name, sc.external_url\n),\napplied AS (\n  UPDATE source_channels sc\n  SET\n    is_active = EXISTS (\n      SELECT 1\n      FROM active_project_links apl\n      WHERE apl.channel_id = sc.id\n    ),\n    linked_projects_count = (\n      SELECT COUNT(DISTINCT apl.project_id)::int\n      FROM active_project_links apl\n      WHERE apl.channel_id = sc.id\n    ),\n    updated_at = now()\n  WHERE sc.platform_id = 2   -- Telegram; уберите для всех платформ\n  RETURNING\n    sc.id,\n    sc.name,\n    sc.external_url,\n    sc.is_active,\n    sc.linked_projects_count\n)\n\nSELECT\n  'SUMMARY'::text AS row_type,\n  CASE WHEN a.is_active THEN 'active' ELSE 'inactive' END AS label,\n  COUNT(*)::text AS value,\n  NULL::bigint AS channel_id,\n  NULL::text AS channel_name,\n  NULL::text AS external_url,\n  NULL::text AS projects\nFROM applied a\nGROUP BY a.is_active\n\nUNION ALL\n\nSELECT\n  'ENABLED_IN_ACTIVE_PROJECT'::text,\n  'active_projects=' || e.active_projects_count::text,\n  e.active_projects_count::text,\n  e.id,\n  COALESCE(e.name, e.external_url),\n  e.external_url,\n  e.project_names\nFROM enabled_in_projects e\n\nUNION ALL\n\nSELECT\n  'DEACTIVATED'::text,\n  CASE\n    WHEN a.id IN (SELECT id FROM enabled_in_projects) THEN 'unexpected'\n    ELSE 'no active+enabled project link'\n  END,\n  NULL::text,\n  a.id,\n  COALESCE(a.name, a.external_url),\n  a.external_url,\n  NULL::text\nFROM applied a\nWHERE a.is_active = false\n\nORDER BY row_type, label, channel_id;",
        "options": {}
      },
