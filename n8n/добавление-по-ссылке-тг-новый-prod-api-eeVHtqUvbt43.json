    {
      "id": "11450159-00c6-4305-bc12-5cc04f8def5b",
      "name": "Execute a SQL query",
      "type": "n8n-nodes-base.postgres",
      "disabled": true,
      "position": [
        -320,
        -32
      ],
      "parameters": {
        "query": "-- scripts/pick_account_add_channel_by_link.sql\n-- psql \"$PGURL\" -v min_threshold=20 -f scripts/pick_account_add_channel_by_link.sql\n\nWITH params AS (\n  SELECT\n    :min_threshold::numeric AS min_available_percent,  -- default 20, как parser_add_channel\n    NULL::bigint          AS prefer_account_id,        -- опционально: конкретный accounts.id\n    ARRAY[]::bigint[]     AS exclude_account_ids       -- опционально: уже отвергнутые\n),\n\n-- Telethon ops для POST /add-channel-by-link (A9 §4, #6)\nrequired_ops AS (\n  SELECT * FROM (VALUES\n    ('get_entity',               2),  -- канал + linked discussion\n    ('channels.JoinChannel',     2),  -- source + discussion\n    ('channels.GetFullChannel',  1),\n    ('channels.GetParticipant',  1),  -- проверка доступа\n    ('channels.GetParticipants', 1)   -- lidgen-скоринг (megagroup / сигналы)\n  ) AS t(op_code, units_required)\n),\n\neligible AS (\n  SELECT\n    a.id,\n    a.session_name,\n    a.status,\n    a.last_used_at,\n    a.cooldown_until\n  FROM accounts a\n  CROSS JOIN params p\n  WHERE a.is_enabled = true\n    AND a.status IN ('active', 'cooldown')\n    AND a.current_task_id IS NULL\n    AND (a.cooldown_until IS NULL OR a.cooldown_until <= now())\n    AND (p.prefer_account_id IS NULL OR a.id = p.prefer_account_id)\n    AND NOT (a.id = ANY (p.exclude_account_ids))\n),\n\n-- C5: у каждого required op available_resource_percent >= порога\nper_op AS (\n  SELECT\n    e.id AS account_id,\n    e.session_name,\n    e.last_used_at,\n    ro.op_code,\n    ro.units_required,\n    u.effective_rph,\n    u.used_last_hour,\n    u.available_resource,\n    u.available_resource_percent,\n    (u.available_resource >= ro.units_required) AS has_units_for_op\n  FROM eligible e\n  CROSS JOIN required_ops ro\n  JOIN resource_op_types rot\n    ON rot.code = ro.op_code AND rot.is_enabled = true\n  JOIN v_account_op_usage_last_hour u\n    ON u.account_id = e.id AND u.op_type_id = rot.id\n),\n\nqualified AS (\n  SELECT\n    po.account_id,\n    po.session_name,\n    po.last_used_at,\n    min(po.available_resource_percent) AS worst_available_percent,\n    bool_and(po.has_units_for_op)      AS all_ops_have_units,\n    jsonb_agg(\n      jsonb_build_object(\n        'op_code', po.op_code,\n        'units_required', po.units_required,\n        'effective_rph', po.effective_rph,\n        'used_last_hour', po.used_last_hour,\n        'available_resource', po.available_resource,\n        'available_percent', po.available_resource_percent\n      )\n      ORDER BY po.op_code\n    ) AS ops_snapshot\n  FROM per_op po\n  CROSS JOIN params p\n  GROUP BY po.account_id, po.session_name, po.last_used_at\n  HAVING min(po.available_resource_percent) >= p.min_available_percent\n     AND bool_and(po.has_units_for_op)\n)\n\nSELECT\n  q.account_id,\n  q.session_name,\n  q.worst_available_percent,\n  q.ops_snapshot\nFROM qualified q\nORDER BY q.last_used_at ASC NULLS FIRST, q.account_id ASC\nLIMIT 1;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "nJLtOwEA1dAE4Pjt",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.6
